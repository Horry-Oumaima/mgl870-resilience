{
  "uid": "mgl870-resilience",
  "title": "MGL870 — Résilience (Timeout, Retry, Circuit Breaker)",
  "tags": [
    "mgl870"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Boutique (A) et banque (B) joignables par Prometheus",
      "description": "1 = Prometheus arrive à lire les mesures du service ; 0 = le service ne répond plus (par exemple la boutique saturée).",
      "datasource": null,
      "interval": "1s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Boutique (A)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Banque (B)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"order\"}",
          "legendFormat": "Boutique (A)",
          "range": true
        },
        {
          "refId": "B",
          "expr": "up{job=\"payment\"}",
          "legendFormat": "Banque (B)",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Disjoncteur (Circuit Breaker)",
      "description": "1 = état actif. Ouvert : la boutique n'appelle plus la banque. Semi-ouvert : appels de test. Visible seulement en C3 et C4.",
      "datasource": null,
      "interval": "1s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ouvert"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e34948"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Semi-ouvert (appels de test)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fermé (normal)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(resilience4j_circuitbreaker_state{state=\"open\"})",
          "legendFormat": "Ouvert",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "legendFormat": "Semi-ouvert (appels de test)",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(resilience4j_circuitbreaker_state{state=\"closed\"})",
          "legendFormat": "Fermé (normal)",
          "range": true
        }
      ]
    },
